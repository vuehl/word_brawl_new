[Unit]
Description=ZiLing cooperative game relay
After=network.target

[Service]
Type=simple
User=ziling
Group=ziling
WorkingDirectory=/opt/ziling-coop
ExecStart=/opt/ziling-coop/ziling-server -listen 0.0.0.0:8787
Restart=on-failure
RestartSec=3
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
