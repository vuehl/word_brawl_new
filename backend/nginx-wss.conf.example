# Optional: replace game.example.com and both certificate paths.
# Put this server block in nginx's http context (usually conf.d/*.conf).
server {
    listen 443 ssl;
    server_name game.example.com;
    ssl_certificate /etc/nginx/certs/game.example.com.fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/game.example.com.key;
    ssl_protocols TLSv1.2;

    location = /ws {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
    }
    location = /healthz {
        proxy_pass http://127.0.0.1:8787;
    }
}
